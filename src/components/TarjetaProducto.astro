---
// =============================================================
// Tarjeta de producto para el catálogo.
// Enlaza a la página de detalle del producto (/catalogo/[id]/).
// Muestra un placeholder visual con degradado según la categoría;
// se reemplazará por fotos reales cuando el cliente las entregue.
// Props:
//   - producto: objeto con { id, nombre, categoria, descripcion, destacado }
// =============================================================
import BotonNeon from './BotonNeon.astro';

const { producto } = Astro.props;

// Degradado de la imagen placeholder según categoría del producto
const degradados = {
  Alpargatas: 'from-neon-cian/30 to-neon-violeta/30',
  Cocuizas: 'from-neon-magenta/30 to-neon-violeta/30',
  Bolsos: 'from-neon-violeta/30 to-neon-cian/30',
  Accesorios: 'from-neon-cian/20 to-neon-magenta/30',
};

const degradado = degradados[producto.categoria] ?? degradados['Accesorios'];
---

<a
  href={`/catalogo/${producto.id}/`}
  class="panel-cristal group block overflow-hidden rounded-xl transition duration-200 hover:-translate-y-1 hover:border-neon-cian/60"
  aria-label={`Ver detalle de ${producto.nombre}`}
>
  <!-- Placeholder visual (reemplazar por <img> con foto real en la entrega final) -->
  <div class={`flex h-44 items-center justify-center bg-linear-to-br ${degradado}`}>
    <span
      class="font-display px-4 text-center text-2xl font-bold uppercase tracking-widest text-texto/70"
    >
      {producto.nombre}
    </span>
  </div>

  <!-- Información del producto -->
  <div class="p-5">
    <p class="font-display text-xs tracking-[0.25em] text-neon-magenta uppercase">
      {producto.categoria}
    </p>
    <h3 class="mt-2 text-lg font-semibold">{producto.nombre}</h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-texto-suave">{producto.descripcion}</p>
    <p class="mt-4 text-xs text-texto-suave italic">
      Precio: a consultar — venta al mayor y detal
    </p>
    <span class="mt-3 inline-block text-sm text-neon-cian">
      Ver detalle →
    </span>
  </div>
</a>
