---
// =============================================================
// Formulario de contacto funcional con Web3Forms (plan gratuito).
// -------------------------------------------------------------
// - La clave de acceso se define en el archivo .env:
//     PUBLIC_WEB3FORMS_KEY="tu-clave-aqui"
// - Obtener una clave gratuita en: https://web3forms.com
// - Envío asíncrono (fetch) con retroalimentación al usuario.
// - Incluye campo «honeypot» antispam recomendado por Web3Forms.
// =============================================================
const claveWeb3Forms = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

// Motivos de contacto predefinidos (ayuda a ordenar los pedidos)
const motivos = [
  'Pedido al mayor (comercios y revendedores)',
  'Pedido al detal',
  'Consulta de precios',
  'Otro motivo',
];
---

{
  claveWeb3Forms ? (
    <form
      id="formulario-contacto"
      class="panel-cristal rounded-xl p-6 md:p-8"
      novalidate
    >
      <!-- Campos ocultos requeridos por Web3Forms -->
      <input type="hidden" name="access_key" value={claveWeb3Forms} />
      <input type="hidden" name="subject" value="Nuevo mensaje desde la web — Artesanía Tauro" />
      <!-- Honeypot antispam: los bots lo rellenan, las personas no lo ven -->
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" style="display:none" />

      <div class="grid gap-5 sm:grid-cols-2">
        <!-- Nombre completo -->
        <div>
          <label for="campo-nombre" class="font-display text-xs tracking-[0.2em] text-neon-cian uppercase">
            Nombre *
          </label>
          <input
            id="campo-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            placeholder="Tu nombre y apellido"
            class="mt-2 w-full rounded-lg border border-borde bg-superficie-2 px-4 py-3 text-texto placeholder:text-texto-suave/50 focus:border-neon-cian focus:outline-none"
          />
        </div>

        <!-- Correo electrónico -->
        <div>
          <label for="campo-email" class="font-display text-xs tracking-[0.2em] text-neon-cian uppercase">
            Correo *
          </label>
          <input
            id="campo-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tucorreo@ejemplo.com"
            class="mt-2 w-full rounded-lg border border-borde bg-superficie-2 px-4 py-3 text-texto placeholder:text-texto-suave/50 focus:border-neon-cian focus:outline-none"
          />
        </div>

        <!-- Teléfono (opcional) -->
        <div>
          <label for="campo-telefono" class="font-display text-xs tracking-[0.2em] text-neon-cian uppercase">
            Teléfono (opcional)
          </label>
          <input
            id="campo-telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            placeholder="+58 414 000 0000"
            class="mt-2 w-full rounded-lg border border-borde bg-superficie-2 px-4 py-3 text-texto placeholder:text-texto-suave/50 focus:border-neon-cian focus:outline-none"
          />
        </div>

        <!-- Motivo de contacto -->
        <div>
          <label for="campo-motivo" class="font-display text-xs tracking-[0.2em] text-neon-cian uppercase">
            Motivo *
          </label>
          <select
            id="campo-motivo"
            name="motivo"
            required
            class="mt-2 w-full rounded-lg border border-borde bg-superficie-2 px-4 py-3 text-texto focus:border-neon-cian focus:outline-none"
          >
            {motivos.map((motivo) => <option value={motivo}>{motivo}</option>)}
          </select>
        </div>

        <!-- Mensaje -->
        <div class="sm:col-span-2">
          <label for="campo-mensaje" class="font-display text-xs tracking-[0.2em] text-neon-cian uppercase">
            Mensaje *
          </label>
          <textarea
            id="campo-mensaje"
            name="mensaje"
            rows="5"
            required
            placeholder="Cuéntanos qué productos te interesan, cantidades y tu ciudad…"
            class="mt-2 w-full rounded-lg border border-borde bg-superficie-2 px-4 py-3 text-texto placeholder:text-texto-suave/50 focus:border-neon-cian focus:outline-none"
          />
        </div>
      </div>

      <!-- Botón de envío y estado -->
      <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <button type="submit" class="boton-neon" id="boton-enviar">
          Enviar mensaje
        </button>
        <p id="mensaje-estado" role="status" aria-live="polite" class="text-sm text-texto-suave" />
      </div>
    </form>
  ) : (
    <!-- Aviso para el desarrollador: falta la clave en .env -->
    <div class="panel-cristal rounded-xl p-6 text-sm text-texto-suave">
      ⚠️ Formulario no configurado: define <code>PUBLIC_WEB3FORMS_KEY</code> en tu archivo
      <code>.env</code> (ver <code>.env.example</code>). Clave gratuita en
      <a href="https://web3forms.com" target="_blank" rel="noopener noreferrer" class="text-neon-cian underline">
        web3forms.com
      </a>
    </div>
  )
}

<script>
  // -------------------------------------------------------------
  // Envío asíncrono del formulario hacia la API de Web3Forms.
  // Muestra retroalimentación sin recargar la página.
  // -------------------------------------------------------------
  const formulario = document.getElementById('formulario-contacto') as HTMLFormElement | null;

  if (formulario) {
    const boton = document.getElementById('boton-enviar') as HTMLButtonElement | null;
    const estado = document.getElementById('mensaje-estado') as HTMLParagraphElement | null;

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!boton || !estado) return;

      // Estado de envío en curso
      boton.disabled = true;
      boton.textContent = 'Enviando…';
      estado.textContent = '';
      estado.classList.remove('text-neon-cian', 'text-red-400');

      try {
        const respuesta = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(formulario),
        });
        const resultado = await respuesta.json();

        if (respuesta.ok && resultado.success) {
          formulario.reset();
          estado.textContent = '✅ ¡Mensaje enviado! Te responderemos pronto.';
          estado.classList.add('text-neon-cian');
        } else {
          throw new Error('respuesta no exitosa');
        }
      } catch {
        estado.textContent =
          '❌ No se pudo enviar el mensaje. Intenta de nuevo o llámanos al +58 251-4468866.';
        estado.classList.add('text-red-400');
      } finally {
        boton.disabled = false;
        boton.textContent = 'Enviar mensaje';
      }
    });
  }
</script>
