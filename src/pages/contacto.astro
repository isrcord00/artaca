---
// =============================================================
// Página «Contacto» — formulario Web3Forms + datos de contacto
// reales de la empresa + mapa de ubicación.
// =============================================================
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import Mapa from '../components/Mapa.astro';

// Datos de contacto reales (fuente: investigación en plan.md)
const contacto = {
  direccion:
    'Carrera 24 entre Calles 41 y 42, Edificio La Alpargata, Barquisimeto 3001, Lara, Venezuela',
  telefonos: [
    { etiqueta: '+58 251-4468866', tel: '+584145122943' },
    { etiqueta: '+58 251-4469065', tel: '+584145123943' },
  ],
  email: 'artesania_tauro@hotmail.com',
  facebook: 'https://www.facebook.com/ArtesaniaTauroCa',
};

// ⚠️ PENDIENTE (plan.md §8): confirmar el WhatsApp comercial con el cliente.
// Mientras no haya número confirmado, el botón no se muestra.
const whatsapp = null;
---

<Base
  titulo="Contacto | Artesanía Tauro, C.A."
  descripcion="Contacta a Artesanía Tauro, C.A.: pedidos al mayor y detal de alpargatas, cocuizas y bolsos artesanales. Barquisimeto, Lara, Venezuela."
>
  <!-- Encabezado de la página -->
  <section class="fondo-rejilla relative overflow-hidden py-20 text-center">
    <div
      class="pointer-events-none absolute -top-20 right-1/4 h-72 w-72 rounded-full bg-neon-cian/10 blur-[100px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4">
      <p class="font-display text-xs tracking-[0.35em] text-neon-magenta uppercase">
        Estamos para atenderte
      </p>
      <h1 class="mt-4 font-display text-3xl font-bold uppercase md:text-5xl">
        <span class="texto-degradado">Contacto</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-texto-suave">
        Escríbenos por pedidos al mayor o detal, cotizaciones y dudas sobre
        nuestros productos. Respondemos lo antes posible.
      </p>
    </div>
  </section>

  <!-- Formulario + tarjetas de contacto -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-8 lg:grid-cols-3">
      <!-- Formulario (ocupa 2 columnas en escritorio) -->
      <div class="lg:col-span-2">
        <h2 class="mb-6 font-display text-2xl font-bold uppercase">
          Envíanos un <span class="text-neon-cian texto-glow-cian">mensaje</span>
        </h2>
        <FormularioContacto />
      </div>

      <!-- Datos de contacto directos -->
      <aside class="space-y-6">
        <div class="panel-cristal rounded-xl p-6">
          <h3 class="font-display text-sm tracking-[0.25em] text-neon-magenta uppercase">
            Teléfonos
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-texto-suave">
            {
              contacto.telefonos.map((telefono) => (
                <li>
                  📞{' '}
                  <a href={`tel:${telefono.tel}`} class="hover:text-neon-cian">
                    {telefono.etiqueta}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel-cristal rounded-xl p-6">
          <h3 class="font-display text-sm tracking-[0.25em] text-neon-magenta uppercase">
            Correo y redes
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-texto-suave">
            <li>
              ✉️{' '}
              <a href={`mailto:${contacto.email}`} class="break-all hover:text-neon-cian">
                {contacto.email}
              </a>
            </li>
            <li>
              📘{' '}
              <a
                href={contacto.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-neon-cian"
              >
                Facebook: Artesanía Tauro, C.A.
              </a>
            </li>
          </ul>
        </div>

        <div class="panel-cristal rounded-xl p-6">
          <h3 class="font-display text-sm tracking-[0.25em] text-neon-magenta uppercase">
            Dirección
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-texto-suave">📍 {contacto.direccion}</p>
          <!-- Horario por confirmar con el cliente (plan.md §8) -->
          <p class="mt-3 text-xs text-texto-suave italic">
            Horario de atención: por confirmar.
          </p>
        </div>

        {
          whatsapp && (
            <a
              href={`https://wa.me/${whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="boton-neon w-full justify-center"
            >
              💬 Escríbenos por WhatsApp
            </a>
          )
        }
      </aside>
    </div>
  </section>

  <!-- Mapa de ubicación -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <h2 class="mb-6 text-center font-display text-2xl font-bold uppercase">
      Nuestra <span class="text-neon-violeta">ubicación</span>
    </h2>
    <Mapa />
  </section>
</Base>
