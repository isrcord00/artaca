---
// =============================================================
// Página de error 404 personalizada con estilo Dark Neon.
// =============================================================
import Base from '../layouts/Base.astro';
import BotonNeon from '../components/BotonNeon.astro';
---

<Base titulo="404 | Página no encontrada" descripcion="La página que buscas no existe.">
  <section class="mx-auto flex min-h-[60vh] max-w-4xl flex-col items-center justify-center px-4 text-center">
    <!-- Código de error con resplandor -->
    <p class="font-display texto-glow-magenta text-7xl font-black text-neon-magenta" aria-hidden="true">
      404
    </p>
    <h1 class="mt-4 font-display text-2xl font-bold uppercase">Página no encontrada</h1>
    <p class="mt-3 text-texto-suave">
      La página que buscas no existe o fue movida de lugar.
    </p>
    <div class="mt-8">
      <BotonNeon texto="Volver al inicio" href="/" variante="neon" />
    </div>
  </section>
</Base>
