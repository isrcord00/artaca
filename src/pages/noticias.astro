---
// =============================================================
// Página «Noticias» — listado de entradas del blog,
// ordenadas de la más reciente a la más antigua.
// =============================================================
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Obtenemos las entradas y las ordenamos por fecha descendente
const entradas = (await getCollection('noticias')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

// Formato de fecha en español (Venezuela)
const formatoFecha = new Intl.DateTimeFormat('es-VE', { dateStyle: 'long' });
---

<Base
  titulo="Noticias | Artesanía Tauro, C.A."
  descripcion="Novedades, colecciones, consejos de cuidado y eventos del taller de calzado artesanal Artesanía Tauro, C.A. de Barquisimeto."
>
  <!-- Encabezado de la página -->
  <section class="fondo-rejilla relative overflow-hidden py-20 text-center">
    <div
      class="pointer-events-none absolute -top-20 right-1/3 h-72 w-72 rounded-full bg-neon-violeta/15 blur-[100px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4">
      <p class="font-display text-xs tracking-[0.35em] text-neon-magenta uppercase">
        Novedades del taller
      </p>
      <h1 class="mt-4 font-display text-3xl font-bold uppercase md:text-5xl">
        <span class="texto-degradado">Noticias</span>
      </h1>
    </div>
  </section>

  <!-- Listado de entradas -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        entradas.map((entrada) => (
          <article class="panel-cristal flex flex-col rounded-xl p-6 transition duration-200 hover:-translate-y-1 hover:border-neon-magenta/60">
            {/* Etiqueta y fecha de publicación */}
            <div class="flex items-center justify-between gap-3 text-xs">
              {entrada.data.etiqueta && (
                <span class="font-display rounded-full border border-neon-magenta/50 px-3 py-1 tracking-[0.15em] text-neon-magenta uppercase">
                  {entrada.data.etiqueta}
                </span>
              )}
              <time datetime={entrada.data.fecha.toISOString()} class="text-texto-suave">
                {formatoFecha.format(entrada.data.fecha)}
              </time>
            </div>

            {/* Título y resumen */}
            <h2 class="mt-4 text-xl font-semibold leading-snug">
              <a href={`/noticias/${entrada.id}/`} class="hover:text-neon-cian">
                {entrada.data.titulo}
              </a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-texto-suave">
              {entrada.data.descripcion}
            </p>

            <a href={`/noticias/${entrada.id}/`} class="mt-4 inline-block text-sm text-neon-cian">
              Leer más →
            </a>
          </article>
        ))
      }
    </div>

    <!-- Suscripción RSS -->
    <p class="mt-12 text-center text-sm text-texto-suave">
      Síguenos por RSS:
      <a href="/rss.xml" class="text-neon-cian underline">/rss.xml</a>
    </p>
  </section>
</Base>
