---
// =============================================================
// Página «Nosotros» — historia, misión y ubicación de la empresa.
// Los textos institucionales son un borrador basado en la
// investigación web; se ajustarán con el cliente (plan.md §8).
// =============================================================
import Base from '../layouts/Base.astro';
import Mapa from '../components/Mapa.astro';

// Valores de la empresa presentados como tarjetas
const valores = [
  {
    titulo: 'Hecho a mano',
    descripcion:
      'Cada par se teje con técnica artesanal heredada, cuidando el detalle y la resistencia de cada punto.',
    color: 'text-neon-cian',
  },
  {
    titulo: 'Al mayor y detal',
    descripcion:
      'Atendemos a comercios y revendedores con precios de mayoreo, y al público general al detal.',
    color: 'text-neon-magenta',
  },
  {
    titulo: 'Identidad venezolana',
    descripcion:
      'La alpargata y la cocuiza son patrimonio de nuestro país: calzado tradicional, fresco y duradero.',
    color: 'text-neon-violeta',
  },
];

// Cifras destacadas (banda de estadísticas)
const cifras = [
  { valor: '100%', etiqueta: 'Tejido a mano' },
  { valor: 'Mayor y detal', etiqueta: 'Modalidad de venta' },
  { valor: 'Lara', etiqueta: 'Hecho en Venezuela' },
];
---

<Base
  titulo="Nosotros | Artesanía Tauro, C.A."
  descripcion="Conoce Artesanía Tauro, C.A.: taller barquisimetano de calzado tejido artesanal. Alpargatas, cocuizas y bolsos hechos a mano, al mayor y detal."
>
  <!-- Encabezado de la página -->
  <section class="fondo-rejilla relative overflow-hidden py-20 text-center">
    <div
      class="pointer-events-none absolute -top-20 left-1/3 h-72 w-72 rounded-full bg-neon-violeta/15 blur-[100px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4">
      <p class="font-display text-xs tracking-[0.35em] text-neon-magenta uppercase">
        Desde Barquisimeto para toda Venezuela
      </p>
      <h1 class="mt-4 font-display text-3xl font-bold uppercase md:text-5xl">
        <span class="texto-degradado">Sobre nosotros</span>
      </h1>
    </div>
  </section>

  <!-- Historia de la empresa -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold uppercase">
          Nuestra <span class="text-neon-cian texto-glow-cian">historia</span>
        </h2>
        <p class="mt-5 leading-relaxed text-texto-suave">
          <strong class="text-texto">Artesanía Tauro, C.A.</strong> es una empresa
          barquisimetana dedicada a la venta al mayor y detal de
          <strong class="text-texto">calzado tejido artesanal</strong>, con especialidad
          en cocuizas, alpargatas y bolsos. Desde nuestro taller en la avenida
          Vargas, en el corazón de Barquisimeto, combinamos técnicas tradicionales
          de tejido con diseños pensados para el uso diario.
        </p>
        <p class="mt-4 leading-relaxed text-texto-suave">
          Cada producto sale de las manos de artesanos larenses y llega a tiendas,
          mercados y clientes de todo el país. Creemos en el calzado cómodo,
          fresco y con identidad venezolana.
        </p>
        <!-- Nota interna: confirmar/redactar historia definitiva con el cliente -->
      </div>

      <!-- Imagen provisional del taller (reemplazar por fotos reales del cliente) -->
      <figure class="panel-cristal overflow-hidden rounded-xl">
        <img
          src="/images/taller.jpg"
          alt="Artesana tejiendo a mano un bolso de fibra natural en el taller de Artesanía Tauro"
          width="960"
          height="640"
          loading="lazy"
          class="w-full object-cover"
        />
        <figcaption class="p-4 text-center text-sm text-texto-suave">
          Tejido a mano en nuestro taller · Barquisimeto, Lara
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Valores / pilares -->
  <section class="border-y border-borde bg-superficie">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center font-display text-2xl font-bold uppercase md:text-3xl">
        Lo que nos <span class="texto-degradado">define</span>
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          valores.map((valor) => (
            <article class="panel-cristal rounded-xl p-6 transition duration-200 hover:-translate-y-1 hover:border-neon-cian/60">
              <h3 class={`font-display text-lg font-bold uppercase ${valor.color}`}>{valor.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-texto-suave">{valor.descripcion}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Banda de cifras -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-6 text-center sm:grid-cols-3">
      {
        cifras.map((cifra) => (
          <div>
            <p class="font-display texto-glow-cian text-3xl font-bold text-neon-cian">{cifra.valor}</p>
            <p class="mt-2 text-sm text-texto-suave">{cifra.etiqueta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <h2 class="mb-6 text-center font-display text-2xl font-bold uppercase">
      Dónde <span class="text-neon-magenta texto-glow-magenta">encontrarnos</span>
    </h2>
    <Mapa />
  </section>
</Base>
